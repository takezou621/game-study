# =============================================================================
# GameCoach Application Configuration
# =============================================================================
# This file shows all available environment variables for configuring the
# application. Copy this file to .env and modify as needed.
#
# Environment variables take precedence over YAML configuration files.
# All variables use the GAMECOACH_ prefix followed by SECTION_VARIABLE.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS (GAMECOACH_APP_*)
# -----------------------------------------------------------------------------

# Application environment: development, testing, production
# Determines which preset configuration is loaded
GAMECOACH_APP_ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
GAMECOACH_APP_LOG_LEVEL=INFO

# Directory for log output files
GAMECOACH_APP_OUTPUT_DIR=./logs

# Enable debug mode (enables additional debugging features)
GAMECOACH_APP_DEBUG_MODE=false

# -----------------------------------------------------------------------------
# AUDIO SETTINGS (GAMECOACH_AUDIO_*)
# -----------------------------------------------------------------------------

# Audio sample rate in Hz (8000-48000)
GAMECOACH_AUDIO_SAMPLE_RATE=16000

# Number of audio channels (1=mono, 2=stereo)
GAMECOACH_AUDIO_CHANNELS=1

# Audio chunk size in samples (64-4096)
GAMECOACH_AUDIO_CHUNK_SIZE=512

# Noise gate threshold level (0.0-1.0)
GAMECOACH_AUDIO_NOISE_GATE_THRESHOLD=0.01

# Noise gate attack time in milliseconds (0-100)
GAMECOACH_AUDIO_NOISE_GATE_ATTACK_MS=5.0

# Noise gate release time in milliseconds (0-500)
GAMECOACH_AUDIO_NOISE_GATE_RELEASE_MS=50.0

# Enable Voice Activity Detection
GAMECOACH_AUDIO_VAD_ENABLED=true

# VAD padding in milliseconds (0-1000)
GAMECOACH_AUDIO_VAD_PADDING_MS=300

# Minimum speech duration in milliseconds (100-5000)
GAMECOACH_AUDIO_VAD_MIN_SPEECH_MS=500

# Maximum speech duration in milliseconds (1000-60000)
GAMECOACH_AUDIO_VAD_MAX_SPEECH_MS=10000

# Audio device index (null for default device)
# GAMECOACH_AUDIO_DEVICE_INDEX=0

# -----------------------------------------------------------------------------
# CAPTURE SETTINGS (GAMECOACH_CAPTURE_*)
# -----------------------------------------------------------------------------

# Capture type: video or screen
GAMECOACH_CAPTURE_TYPE=video

# Path to video file (for video capture type)
# GAMECOACH_CAPTURE_VIDEO_PATH=./sample.mp4

# Loop video playback
GAMECOACH_CAPTURE_LOOP_VIDEO=false

# Monitor index for screen capture (0=primary, 1=secondary, etc.)
GAMECOACH_CAPTURE_MONITOR_INDEX=1

# Capture region as comma-separated values: x,y,width,height
# GAMECOACH_CAPTURE_REGION=0,0,1920,1080

# -----------------------------------------------------------------------------
# TRIGGER SETTINGS (GAMECOACH_TRIGGER_*)
# -----------------------------------------------------------------------------

# Path to triggers configuration file
GAMECOACH_TRIGGER_CONFIG_PATH=./configs/triggers.yaml

# Cooldown period between triggers in milliseconds (0-60000)
GAMECOACH_TRIGGER_COOLDOWN_MS=5000

# Maximum response length in milliseconds (1000-120000)
GAMECOACH_TRIGGER_MAX_RESPONSE_LENGTH_MS=10000

# -----------------------------------------------------------------------------
# LLM SETTINGS (GAMECOACH_LLM_*)
# -----------------------------------------------------------------------------

# OpenAI API Key (recommended to use OPENAI_API_KEY instead)
# SECURITY: This value is masked in logs and configuration dumps
# GAMECOACH_LLM_API_KEY=sk-your-api-key-here

# Alternative: Standard OpenAI environment variable (preferred)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model to use
GAMECOACH_LLM_MODEL=gpt-4o

# Voice for audio responses (alloy, echo, fable, onyx, nova, shimmer)
GAMECOACH_LLM_VOICE=alloy

# Use OpenAI Realtime API
GAMECOACH_LLM_USE_REALTIME_API=true

# Maximum tokens in response (1-4096)
GAMECOACH_LLM_MAX_TOKENS=500

# Response temperature/randomness (0.0-2.0)
GAMECOACH_LLM_TEMPERATURE=0.7

# Path to system prompt file
GAMECOACH_LLM_SYSTEM_PROMPT_PATH=./configs/prompts/system.txt

# -----------------------------------------------------------------------------
# FEATURE FLAGS (GAMECOACH_FEATURES_*)
# -----------------------------------------------------------------------------

# Enable audio capture functionality
GAMECOACH_FEATURES_ENABLE_AUDIO_CAPTURE=true

# Enable screen capture functionality
GAMECOACH_FEATURES_ENABLE_SCREEN_CAPTURE=true

# Enable video file capture functionality
GAMECOACH_FEATURES_ENABLE_VIDEO_CAPTURE=true

# Enable OpenAI Realtime API
GAMECOACH_FEATURES_ENABLE_REALTIME_API=true

# Enable Voice Activity Detection
GAMECOACH_FEATURES_ENABLE_VAD=true

# Enable noise gate processing
GAMECOACH_FEATURES_ENABLE_NOISE_GATE=true

# Enable detailed debug logging
GAMECOACH_FEATURES_ENABLE_DEBUG_LOGGING=false

# Enable performance metrics collection
GAMECOACH_FEATURES_ENABLE_PERFORMANCE_METRICS=false

# =============================================================================
# LEGACY VARIABLES (for backward compatibility)
# =============================================================================
# These variables are kept for backward compatibility but may be deprecated

# Log Format: json or text
LOG_FORMAT=json

# Configuration Paths
ROI_CONFIG=./configs/roi_defaults.yaml
TRIGGERS_CONFIG=./configs/triggers.yaml
SYSTEM_PROMPT=./configs/prompts/system.txt

# Security Settings
WEBRTC_SECRET_KEY=your-secret-key-here
API_RATE_LIMIT=60
WEBRTC_PORT=8080

# Legacy Feature Flags
ENABLE_AUDIO_OUTPUT=true
ENABLE_VISION=true
ENABLE_TRIGGERS=true

# =============================================================================
# EXAMPLE PRESETS
# =============================================================================
# Uncomment ONE of the following sections based on your environment:

# --- DEVELOPMENT ---
# GAMECOACH_APP_ENVIRONMENT=development
# GAMECOACH_APP_LOG_LEVEL=DEBUG
# GAMECOACH_APP_DEBUG_MODE=true
# GAMECOACH_FEATURES_ENABLE_DEBUG_LOGGING=true
# GAMECOACH_FEATURES_ENABLE_PERFORMANCE_METRICS=true

# --- TESTING ---
# GAMECOACH_APP_ENVIRONMENT=testing
# GAMECOACH_APP_LOG_LEVEL=WARNING
# GAMECOACH_APP_DEBUG_MODE=false
# GAMECOACH_LLM_TEMPERATURE=0.0
# GAMECOACH_LLM_MAX_TOKENS=100

# --- PRODUCTION ---
# GAMECOACH_APP_ENVIRONMENT=production
# GAMECOACH_APP_LOG_LEVEL=INFO
# GAMECOACH_APP_DEBUG_MODE=false
# GAMECOACH_FEATURES_ENABLE_DEBUG_LOGGING=false
# GAMECOACH_FEATURES_ENABLE_PERFORMANCE_METRICS=true
